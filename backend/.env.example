PORT=5000
MONGO_URI=mongodb://localhost:27017/astrology_app
JWT_SECRET=your_super_secret_jwt_key_here
ASTROLOGY_API_KEY=your_freeastrologyapi_key_here
ASTROLOGY_API_BASE_URL=https://json.freeastrologyapi.com
NODE_ENV=development

# Frontend URL (used in password reset email link)
CLIENT_URL=http://localhost:5173

# Email / SMTP — required to send password reset emails
# Gmail: generate an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
